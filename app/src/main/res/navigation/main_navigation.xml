<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main_navigation"
    app:startDestination="@id/homeFragment">

    <fragment
        android:id="@+id/homeFragment"
        android:name="id.ac.polbeng.rustitaayuni.navigationexample.HomeFragment"
        android:label="fragment_home"
        tools:layout="@layout/fragment_home">

        <action
            android:id="@+id/action_homeFragment_to_categoryFragment"
            app:destination="@id/categoryFragment" />

        <action
            android:id="@+id/action_homeFragment_to_profileActivity"
            app:destination="@id/profileActivity" />

    </fragment>

    <fragment
        android:id="@+id/categoryFragment"
        android:name="id.ac.polbeng.rustitaayuni.navigationexample.CategoriFragment"
        android:label="fragment_categori"
        tools:layout="@layout/fragment_categori">

        <action
            android:id="@+id/action_categoryFragment_to_detailCategoryFragment"
            app:destination="@id/detailCategoryFragment" />

    </fragment>

    <activity
        android:id="@+id/profileActivity"
        android:name="id.ac.polbeng.rustitaayuni.navigationexample.ProfileActivity"
        android:label="Profile"
        tools:layout="@layout/activity_profile" />

    <fragment
        android:id="@+id/detailCategoryFragment"
        android:name="id.ac.polbeng.rustitaayuni.navigationexample.DetailCategoryFragment"
        android:label="fragment_detail_category"
        tools:layout="@layout/fragment_detail_category">

        <argument
            android:name="name"
            app:argType="string"
            android:defaultValue="default name" />

        <argument
            android:name="stock"
            app:argType="long"
            android:defaultValue="0L" />
        <action
            android:id="@+id/action_detailCategoryFragment_to_homeFragment"
            app:destination="@id/homeFragment"
            app:launchSingleTop="true"
            app:popUpTo="@id/homeFragment"
            app:popUpToInclusive="true" />

    </fragment>

</navigation>
